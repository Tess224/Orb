# ===================================================================
# Orb - Environment Variables Configuration
# ===================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# ===================================================================

# Flask Configuration
FLASK_ENV=development  # Set to 'production' for production deployment
FLASK_SECRET_KEY=your-secret-key-here-generate-a-random-string

# Security: CORS Allowed Origins (comma-separated)
# Example: https://yourapp.com,https://www.yourapp.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# API Keys
BIRDEYE_API_KEY=your-birdeye-api-key-here
JUPITER_API_KEY=your-jupiter-api-key-here

# RPC URLs
HELIUS_RPC_URL=https://your-helius-rpc-url-here
CHAINLINK_RPC_URL=https://your-chainlink-rpc-url-here

# Web Push Notifications (Optional)
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_EMAIL=your-email@example.com

# ===================================================================
# SECURITY NOTES:
# ===================================================================
# 1. Generate strong random values for secret keys:
#    python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# 2. Never expose these values in:
#    - Git commits
#    - Log files
#    - Error messages
#    - Client-side code
#
# 3. Use different values for development and production
#
# 4. Rotate credentials regularly
# ===================================================================
