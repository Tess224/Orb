# ===================================================================
# Orb - Environment Variables Configuration
# ===================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# ===================================================================

# Flask Configuration
FLASK_ENV=development  # Set to 'production' for production deployment
FLASK_SECRET_KEY=your-secret-key-here-generate-a-random-string
FLASK_HOST=127.0.0.1  # Use '0.0.0.0' for Railway/Docker, '127.0.0.1' for local dev

# Security: CORS Allowed Origins (comma-separated)
# Example: https://yourapp.com,https://www.yourapp.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Admin Authentication
# Generate a strong random access code for admin operations
ADMIN_ACCESS_CODE=generate-a-strong-random-code-here

# Access Code Rate Limits (OPTIONAL - comma-separated code:limit pairs)
# Anonymous users (no code) automatically get 10 analyses/day
# Use this to give specific users higher limits
# Example: PREMIUM-USER-1:50,PREMIUM-USER-2:100,VIP:999
ACCESS_CODE_LIMITS=

# API Keys
BIRDEYE_API_KEY=your-birdeye-api-key-here
JUPITER_API_KEY=your-jupiter-api-key-here

# RPC URLs
HELIUS_RPC_URL=https://your-helius-rpc-url-here
CHAINLINK_RPC_URL=https://your-chainlink-rpc-url-here

# Web Push Notifications (Optional)
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_EMAIL=your-email@example.com

# ===================================================================
# SECURITY NOTES:
# ===================================================================
# 1. Generate strong random values for secret keys:
#    python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# 2. Never expose these values in:
#    - Git commits
#    - Log files
#    - Error messages
#    - Client-side code
#
# 3. Use different values for development and production
#
# 4. Rotate credentials regularly
# ===================================================================

# ===================================================================
# RATE LIMITING SYSTEM:
# ===================================================================
# How it works:
#
# 1. ANONYMOUS USERS (no access_code in request):
#    - Automatically get 10 analyses per day
#    - No registration or access code needed
#    - Perfect for public access
#
# 2. USERS WITH ACCESS CODES:
#    - Can get higher limits via ACCESS_CODE_LIMITS
#    - Send access_code in JSON request body
#    - Example: {"token_address": "...", "access_code": "PREMIUM-USER-1"}
#
# 3. ADMIN USERS:
#    - Use ADMIN_ACCESS_CODE for admin operations
#    - Can clear cache, build transition matrices, etc.
#
# Example ACCESS_CODE_LIMITS configuration:
#   ACCESS_CODE_LIMITS=BASIC:20,PREMIUM:100,VIP:999
#
# This gives:
#   - Anonymous users: 10/day (default)
#   - "BASIC" code holders: 20/day
#   - "PREMIUM" code holders: 100/day
#   - "VIP" code holders: 999/day (basically unlimited)
# ===================================================================
